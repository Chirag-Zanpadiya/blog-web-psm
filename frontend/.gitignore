# See https://github.com/github/gitignore/blob/main/Node.gitignore

# Node modules
node_modules/

# Build output
dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Optional npm cache directory
.npm/

# Optional eslint cache
.eslintcache

# dotenv environment variables file
.env
.env.*.local

# Mac system files
.DS_Store

# IDE/editor specific files
.vscode/
.idea/

# coverage output from testing
coverage/

# Parcel cache
.cache/

# next.js build output
.next/

# SvelteKit build output
.svelte-kit/

# React Native
ios/
android/

# Misc
*.log
*.tgz
*.swp
